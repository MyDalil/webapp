{
  "name": "dalil-webapp",
  "version": "1.0.0",
  "description": "DALIL — le guide de l’Algérie",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/check-boundaries.mjs && node scripts/db-check.mjs && cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm migrate:data && node scripts/index-if-needed.mjs && pnpm build",
    "check": "node scripts/check-boundaries.mjs && tsc --noEmit",
    "migrate:data": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/flush-deferred.ts",
    "search:index": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/reindex-search.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@vercel/blob": "2.8.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "maplibre-gl": "6.16.0",
    "motion": "14.3.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "28.0.0",
    "pg": "8.20.0",
    "postcss": "^8.5.29",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@>=4.0.0 <6.29.1": "^6.29.1",
      "sharp@<0.35.5": "^0.35.5",
      "dompurify@<3.4.17": "^3.4.17",
      "happy-dom@<21.0.4": "^21.0.4",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "esbuild@<=0.24.2": "^0.25.0"
    }
  },
  "private": true,
  "packageManager": "pnpm@10.28.0"
}
