# Base Neon (injectée automatiquement par l'intégration Neon sur Vercel)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optionnel : sinon dérivé de DATABASE_URL
PAYLOAD_SECRET=
# Injecté par Vercel Blob (stockage des images)
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=https://mydalil.com
# En ligne : email obligatoire du tout premier compte /admin (base vide) ; à défaut salam@mydalil.com
DALIL_ADMIN_EMAIL=
# Extras branchés, séparés par des virgules : agents, cockpit, communication (absent : communication seulement)
DALIL_PLUGINS=communication
# Clés d’accès au serveur MCP de DALIL, séparées par des virgules
DALIL_MCP_KEYS=
# Secret de signature des jetons OAuth (long et aléatoire)
OAUTH_SECRET=
# Version de la clé OAuth en cours (à incrémenter à chaque rotation de OAUTH_SECRET)
OAUTH_KEY_VERSION=1
# Jeton du bot Telegram (fourni par BotFather)
TELEGRAM_BOT_TOKEN=
# Identifiant du groupe Telegram de l’équipe (nombre négatif)
TELEGRAM_GROUP_ID=
# Jeton d’accès de l’API WhatsApp Cloud (Meta)
WHATSAPP_TOKEN=
# Identifiant du numéro WhatsApp expéditeur (Meta)
WHATSAPP_PHONE_NUMBER_ID=
# Jeton choisi par l’équipe pour valider le webhook WhatsApp
WHATSAPP_VERIFY_TOKEN=
# Secret de l’application Meta : vérifie la signature des webhooks WhatsApp
WHATSAPP_APP_SECRET=
# Clé OpenAI : transcription des messages vocaux
OPENAI_API_KEY=
# Nom du bot Telegram sans @ (liens « Ouvrir le bot » ; sinon lu auprès de Telegram)
TELEGRAM_BOT_USERNAME=
# Transcription des vocaux : openai (défaut) ou groq
TRANSCRIBE_PROVIDER=
# Clé Groq (seulement si TRANSCRIBE_PROVIDER=groq)
GROQ_API_KEY=
# Paiement en ligne en dinars (Chargily Pay) : clé secrète du tableau de bord Chargily
CHARGILY_SECRET_KEY=
# Mode Chargily : test ou live (sinon déduit du préfixe de la clé)
CHARGILY_MODE=
# Paiement en ligne en euros (Stripe) : clé secrète
STRIPE_SECRET_KEY=
# Secret de signature du webhook Stripe (/api/paiement/stripe)
STRIPE_WEBHOOK_SECRET=
