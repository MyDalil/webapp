# Base Neon (injectée automatiquement par l'intégration Neon sur Vercel)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optionnel : sinon dérivé de DATABASE_URL
PAYLOAD_SECRET=
# Injecté par Vercel Blob (stockage des images)
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=https://mydalil.com
# En ligne : email obligatoire du tout premier compte /admin (base vide)
DALIL_ADMIN_EMAIL=
